# =========================================
# AZARED - Environment Configuration Example
# Copy this file to .env for local development
# On Vercel, set these as Environment Variables in the dashboard instead
# NEVER commit the real .env file to version control
# =========================================

APP_NAME=AZARED
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-azared-app.vercel.app
APP_TIMEZONE=Asia/Jakarta
APP_KEY=change_this_to_a_random_32_char_secret_key

# Database (MySQL) - use a managed MySQL host reachable from the internet,
# e.g. PlanetScale, AWS RDS, Railway, DigitalOcean Managed MySQL, etc.
# Vercel serverless functions cannot host MySQL themselves.
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_DATABASE=azared
DB_USERNAME=azared_user
DB_PASSWORD=change_this_password
DB_SSL=true

# Session / Security
SESSION_LIFETIME_MINUTES=120
REMEMBER_ME_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CSRF_TOKEN_NAME=azared_csrf_token
